#!/usr/bin/env bash
# Git pre-commit hook: stop a commit when any file resembles real patient data.
# Runs the same synthetic-data guard as ./scripts/check and CI, but before the push.
# Install once, from the root of the main clone:
#   ln -s ../../scripts/pre-commit .git/hooks/pre-commit
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
exec uv run python scripts/check_synthetic_data.py
