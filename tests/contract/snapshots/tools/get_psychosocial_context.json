                  }
                },
                "required": [
                  "resource_type",
                  "id"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "status": {
              "description": "unknown when a category could not be read completely",
              "enum": [
                "found",
                "not_found",
                "unknown"
              ],
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "domain",
            "title",
            "status",
            "families",
            "observation_references"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "is_diagnosis": {
        "const": false,
        "default": false,
        "description": "Always false: these results are never a diagnosis",
        "type": "boolean"
      },
      "military": {
        "additionalProperties": false,
