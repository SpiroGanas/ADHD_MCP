                                "description": "meta.versionId when the server has one"
                              }
                            },
                            "required": [
                              "resource_type",
                              "id"
                            ],
                            "type": "object"
                          },
                          "minItems": 1,
                          "type": "array"
                        },
                        "resolved": {
                          "description": "True when the latest record is resolved or inactive",
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "code",
                        "onset",
                        "first_recorded",
                        "last_recorded",
                        "clinical_status",
                        "resolved",
