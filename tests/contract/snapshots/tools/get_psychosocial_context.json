            "category": {
              "description": "A FHIR resource type",
              "minLength": 1,
              "type": "string"
            },
            "records": {
              "default": 0,
              "description": "Records read",
              "type": "integer"
            },
            "skipped": {
              "default": 0,
              "description": "Resources not used: entered in error, refuted or malformed",
              "type": "integer"
            },
            "status": {
              "enum": [
                "available",
                "empty",
                "incomplete",
                "withheld",
                "not_supported",
                "failed"
              ],
              "type": "string"
            },
            "warnings": {
              "description": "Server warning codes, e.g. incomplete, suppressed",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "category",
            "status"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "definition_version": {
        "type": "string"
      },
