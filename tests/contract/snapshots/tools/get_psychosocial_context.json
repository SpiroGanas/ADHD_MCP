                      "QuestionnaireResponse",
                      "MedicationRequest",
                      "MedicationDispense",
                      "MedicationStatement",
                      "Medication",
                      "Encounter",
                      "Procedure",
                      "ServiceRequest",
                      "CarePlan",
                      "Flag"
                    ],
                    "type": "string"
                  },
