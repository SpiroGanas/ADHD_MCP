{
  "annotations": {
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "Report a patient's psychosocial context from coded data: homelessness or housing instability (Z59.0, Z59.81), legal problems (Z65.0-Z65.3), and education or employment problems (Z55, Z56), from Condition codes and coded social-history Observation values; and the date of separation from military service where the site records it. Each domain is found, not_found, or unknown when data could not be read; a missing separation date is unknown, never assumed. Coded data under-records these problems, so not_found is weak evidence of absence. Read-only. Not a diagnosis.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "as_of": {
        "anyOf": [
          {
            "format": "date",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Read the record as of this date (YYYY-MM-DD); data dated later is ignored. Defaults to today. Must not be in the future."
      },
      "patient_id": {
        "description": "FHIR id of the Patient resource: 1 to 64 letters, digits, '-' or '.'",
        "type": "string"
      }
    },
    "required": [
      "patient_id"
    ],
    "type": "object"
  },
  "name": "get_psychosocial_context",
  "outputSchema": {
