                  "entries"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "observation_references": {
              "description": "Social-history Observations whose coded value is in the domain",
              "items": {
                "additionalProperties": false,
                "description": "A pointer to the FHIR resource a fact came from.",
                "properties": {
                  "id": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "resource_type": {
                    "enum": [
                      "Patient",
                      "Condition",
