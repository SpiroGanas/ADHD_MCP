{
  "annotations": {
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "Return a timeline of screening instrument results in a patient's FHIR record (PHQ-9, PHQ-2, C-SSRS risk level, AUDIT-C, PC-PTSD-5, ASRS-5 where coded), read from Observation panels, standalone results and QuestionnaireResponses. Each entry gives the date, score or coded answer, the cutoff that applies (sex-specific where the instrument has one) and whether it was applied, and the resource it came from. Unknown survey instruments are listed but not scored. A cutoff is applied only when its code and value are verified; code_verified and cutoff.status say so. Read-only. A score meeting a cutoff is a screening result for a clinician to review, not a diagnosis. No instrument item text is returned.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "as_of": {
        "anyOf": [
          {
            "format": "date",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Read the record as of this date (YYYY-MM-DD); data dated later is ignored. Defaults to today. Must not be in the future."
      },
      "patient_id": {
        "description": "FHIR id of the Patient resource: 1 to 64 letters, digits, '-' or '.'",
        "type": "string"
      }
    },
    "required": [
      "patient_id"
    ],
    "type": "object"
  },
  "name": "get_screening_history",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "as_of": {
        "description": "The date the record was read as of",
        "format": "date",
        "type": "string"
      },
      "data_completeness": {
        "description": "Each data category read: available, empty, incomplete or failed. An empty record is not a clean record.",
        "items": {
          "additionalProperties": false,
          "description": "Whether one data category could be read, so an empty record is never mistaken\nfor a clean one.",
          "properties": {
            "category": {
              "description": "A FHIR resource type",
              "minLength": 1,
              "type": "string"
            },
            "records": {
              "default": 0,
              "description": "Records read",
              "type": "integer"
            },
            "skipped": {
              "default": 0,
              "description": "Resources not used: entered in error, refuted or malformed",
              "type": "integer"
            },
            "status": {
              "enum": [
                "available",
                "empty",
                "incomplete",
                "withheld",
                "not_supported",
                "failed"
              ],
              "type": "string"
            },
            "warnings": {
              "description": "Server warning codes, e.g. incomplete, suppressed",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "category",
            "status"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "entries": {
        "description": "Timeline, oldest first; undated last",
        "items": {
          "additionalProperties": false,
          "properties": {
            "answer": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "display": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null
                    },
                    "system": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "system",
                    "code"
                  ],
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "A coded answer, e.g. a risk level"
            },
            "code": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "display": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null
                    },
                    "system": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "system",
                    "code"
                  ],
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The instrument code of this measure"
            },
            "code_verified": {
              "description": "Whether that code is verified in the terminology",
              "type": "boolean"
            },
            "cutoff": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "description": "The cutoff for one score and whether it was applied.",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "met": {
                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "Whether the score meets the cutoff; null if not applied"
                    },
                    "operator": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null,
                      "description": "Only given once verified"
                    },
                    "sex": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null,
                      "description": "any, male or female; once verified"
                    },
                    "source": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null,
                      "description": "Where the verified cutoff comes from"
                    },
                    "status": {
                      "enum": [
                        "applied",
                        "not_applied_unverified",
                        "not_applied_sex_unknown",
                        "not_applied_no_score"
                      ],
                      "type": "string"
                    },
                    "value": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null,
                      "description": "Only given once verified"
                    }
                  },
                  "required": [
                    "id",
                    "status",
                    "met"
                  ],
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Null when the measure has no cutoff"
            },
            "date": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "form": {
              "enum": [
                "observation",
                "questionnaire_response"
              ],
              "type": "string"
            },
            "instrument": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Instrument id; null for an unknown instrument"
            },
            "instrument_title": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "item": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Item number for an item score"
            },
            "measure": {
              "enum": [
                "total_score",
                "item",
                "risk_level",
                "unknown"
              ],
              "type": "string"
            },
            "questionnaire": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Questionnaire URL, if any"
            },
            "references": {
              "items": {
                "additionalProperties": false,
                "description": "A pointer to the FHIR resource a fact came from.",
                "properties": {
                  "id": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "resource_type": {
                    "enum": [
                      "Patient",
                      "Condition",
                      "Observation",
                      "QuestionnaireResponse",
                      "MedicationRequest",
                      "MedicationDispense",
                      "MedicationStatement",
                      "Medication",
                      "Encounter",
                      "Procedure",
                      "ServiceRequest",
                      "CarePlan",
                      "Flag"
                    ],
                    "type": "string"
                  },
                  "version": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "meta.versionId when the server has one"
                  }
                },
                "required": [
                  "resource_type",
                  "id"
                ],
                "type": "object"
              },
              "minItems": 1,
              "type": "array"
            },
            "score": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "instrument",
            "instrument_title",
            "measure",
            "date",
            "score",
            "code",
            "code_verified",
            "form",
            "cutoff",
            "references"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "instruments_checked": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "is_diagnosis": {
        "const": false,
        "default": false,
        "description": "Always false: these results are never a diagnosis",
        "type": "boolean"
      },
      "notice": {
        "description": "Standard notice on how to read these results",
        "type": "string"
      },
      "patient_id": {
        "type": "string"
      },
      "privacy": {
        "additionalProperties": false,
        "description": "What the sensitive-data policy withheld or restricted",
        "properties": {
          "policy": {
            "description": "Policy id and version",
            "type": "string"
          },
          "restricted": {
            "description": "Records used, but shown only as references and dates (codes appear as 'restricted'), by category",
            "items": {
              "additionalProperties": false,
              "properties": {
                "category": {
                  "description": "Protected category, e.g. substance_use",
                  "type": "string"
                },
                "records": {
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "category",
                "records"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "withheld": {
            "description": "Records removed before evidence assembly, by category; they were not used by any rule",
            "items": {
              "additionalProperties": false,
              "properties": {
                "category": {
                  "description": "Protected category, e.g. substance_use",
                  "type": "string"
                },
                "records": {
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "category",
                "records"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "policy"
        ],
        "type": "object"
      },
      "versions": {
        "additionalProperties": false,
        "properties": {
          "ruleset": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "scorer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "server": {
            "type": "string"
          },
          "site_codes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Local code mapping in use: id and version"
          },
          "tool_contract": {
            "type": "string"
          }
        },
        "required": [
          "server",
          "tool_contract"
        ],
        "type": "object"
      }
    },
    "required": [
      "patient_id",
      "as_of",
      "notice",
      "data_completeness",
      "privacy",
      "versions",
      "entries",
      "instruments_checked"
    ],
    "type": "object"
  },
  "title": "Get Screening History"
}
