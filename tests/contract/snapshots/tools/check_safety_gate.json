{
  "annotations": {
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "Check a patient's FHIR record for self-harm signals that must be addressed before any screening referral: suicidal ideation, suicide attempt and self-harm codes (including intentional and undetermined-intent poisoning), history of suicidal behavior, PHQ-9 item 9, C-SSRS risk level, psychiatric inpatient or residential discharge within 365 days (90 days is highest priority) and active high-risk flags. Call it first, before any other assessment. Returns positive, clear, clear_limited_data or data_unavailable, every check with its outcome (found, not found, not performed, failed), and the FHIR resources behind each signal. A positive result carries fixed guidance on suicide risk evaluation and lethal-means counseling. Read-only. It reports what the record contains; it does not assess suicide risk and is not a diagnosis. clear_limited_data means some checks could not run or the record is empty, so absence of signals is not reassurance.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "as_of": {
        "anyOf": [
          {
            "format": "date",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Read the record as of this date (YYYY-MM-DD); data dated later is ignored. Defaults to today. Must not be in the future."
      },
      "patient_id": {
        "description": "FHIR id of the Patient resource: 1 to 64 letters, digits, '-' or '.'",
        "type": "string"
      }
    },
    "required": [
      "patient_id"
    ],
    "type": "object"
  },
  "name": "check_safety_gate",
