                        "Flag"
                      ],
                      "type": "string"
                    },
                    "version": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null,
                      "description": "meta.versionId when the server has one"
                    }
                  },
                  "required": [
                    "resource_type",
                    "id"
                  ],
                  "type": "object"
                },
                "minItems": 1,
