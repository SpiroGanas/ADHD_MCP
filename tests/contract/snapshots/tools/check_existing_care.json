                  "properties": {
                    "id": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "resource_type": {
                      "enum": [
                        "Patient",
                        "Condition",
                        "Observation",
                        "QuestionnaireResponse",
                        "MedicationRequest",
                        "MedicationDispense",
                        "MedicationStatement",
                        "Medication",
                        "Encounter",
                        "Procedure",
                        "ServiceRequest",
