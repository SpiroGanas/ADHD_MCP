            },
            "description": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "outcome": {
              "enum": [
                "found",
                "not_found",
                "not_performed",
                "failed"
              ],
              "type": "string"
            },
            "reason": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Why not performed or failed"
            },
            "references": {
              "items": {
                "additionalProperties": false,
                "description": "A pointer to the FHIR resource a fact came from.",
                "properties": {
                  "id": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "resource_type": {
                    "enum": [
                      "Patient",
                      "Condition",
                      "Observation",
                      "QuestionnaireResponse",
                      "MedicationRequest",
                      "MedicationDispense",
                      "MedicationStatement",
                      "Medication",
                      "Encounter",
                      "Procedure",
                      "ServiceRequest",
                      "CarePlan",
                      "Flag"
                    ],
                    "type": "string"
                  },
                  "version": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "meta.versionId when the server has one"
                  }
                },
                "required": [
                  "resource_type",
                  "id"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "check",
            "outcome"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "is_diagnosis": {
        "const": false,
        "default": false,
        "description": "Always false: these results are never a diagnosis",
        "type": "boolean"
      },
      "narcolepsy": {
