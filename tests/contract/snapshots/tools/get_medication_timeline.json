                          "description": "meta.versionId when the server has one"
                        }
                      },
                      "required": [
                        "resource_type",
                        "id"
                      ],
                      "type": "object"
                    },
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": [
