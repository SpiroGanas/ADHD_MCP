{
  "annotations": {
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "Summarize a patient's exposure to the drug classes the referral rules use: stimulant and non-stimulant ADHD medications, antidepressants and sedative-hypnotics (RxNorm ingredient classes). Builds exposure periods from dispenses and medication statements (and from orders only when the record has no dispensing data), merging overlapping fills and splitting at gaps longer than 30 days; a missing days supply is assumed to be 30 days and flagged. Lists each order with its fill status (filled, not filled, unknown), the count of distinct agents per class (dose and brand variants count once), and marks medication ordered for narcolepsy. Medications in no class are counted, not named. Read-only. A medication in the record is not a diagnosis.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "as_of": {
        "anyOf": [
          {
            "format": "date",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Read the record as of this date (YYYY-MM-DD); data dated later is ignored. Defaults to today. Must not be in the future."
      },
      "patient_id": {
        "description": "FHIR id of the Patient resource: 1 to 64 letters, digits, '-' or '.'",
        "type": "string"
      }
    },
    "required": [
      "patient_id"
    ],
    "type": "object"
  },
  "name": "get_medication_timeline",
