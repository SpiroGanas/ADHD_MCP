              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "category",
            "status"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "definition_version": {
        "type": "string"
      },
      "distinct_agents": {
        "description": "One entry per class checked",
        "items": {
          "additionalProperties": false,
